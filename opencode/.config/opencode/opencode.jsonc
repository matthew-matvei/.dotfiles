{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "autoupdate": true,
  "tools": {
    "write": true,
    "bash": true
  },
  "formatter": true,
  "lsp": true,
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    }
  }
}
