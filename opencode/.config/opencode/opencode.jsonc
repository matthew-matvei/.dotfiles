{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "autoupdate": true,
  "tools": {
    "write": true,
    "bash": true
  },
  "formatter": true,
  "lsp": true,
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "bash": {
      "git *": "allow",
      "dotnet *": "allow",
      "npm *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "bun *": "allow",
      "cargo *": "allow",
      "go *": "allow",
      "python *": "allow",
      "pytest *": "allow",
      "make *": "allow",
      "echo *": "allow",
      "*": "ask"
    },
    "external_directory": {
      "/tmp/**": "allow",
      "~/.nuget/packages/**": "allow"
    }
  }
}
